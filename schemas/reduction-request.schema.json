{
  "$comment": "Generated by scripts/generate_schemas.py. Do not edit manually.",
  "$defs": {
    "FailureCode": {
      "description": "Stable V1 qualification failure taxonomy.",
      "enum": [
        "PREFLIGHT_UNSUPPORTED",
        "CORPUS_INVALID",
        "PLUGIN_COMPILE_FAILED",
        "ONNX_PARSE_FAILED",
        "ENGINE_BUILD_FAILED",
        "ENGINE_DESERIALIZE_FAILED",
        "PROFILE_REJECTED",
        "EXECUTION_FAILED",
        "OUTPUT_SCHEMA_CHANGED",
        "NONFINITE_OUTPUT",
        "NUMERICAL_REGRESSION",
        "NONDETERMINISM_REGRESSION",
        "PERFORMANCE_REGRESSION",
        "MEMORY_REGRESSION",
        "SANITIZER_FAILURE",
        "INFRASTRUCTURE_INVALID",
        "INCONCLUSIVE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "NumericalPredicate": {
      "additionalProperties": false,
      "description": "Elementwise failure relation that reduction must preserve.",
      "properties": {
        "atol": {
          "minimum": 0,
          "title": "Atol",
          "type": "number"
        },
        "candidate_path": {
          "title": "Candidate Path",
          "type": "string"
        },
        "kind": {
          "const": "numerical",
          "title": "Kind",
          "type": "string"
        },
        "output_name": {
          "title": "Output Name",
          "type": "string"
        },
        "reference_path": {
          "title": "Reference Path",
          "type": "string"
        },
        "rtol": {
          "minimum": 0,
          "title": "Rtol",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "output_name",
        "reference_path",
        "candidate_path",
        "atol",
        "rtol"
      ],
      "title": "NumericalPredicate",
      "type": "object"
    },
    "ProfilePredicate": {
      "additionalProperties": false,
      "description": "Concrete shape outside a locked optimization profile.",
      "properties": {
        "input_name": {
          "title": "Input Name",
          "type": "string"
        },
        "kind": {
          "const": "profile",
          "title": "Kind",
          "type": "string"
        },
        "maximum_shape": {
          "items": {
            "type": "integer"
          },
          "title": "Maximum Shape",
          "type": "array"
        },
        "minimum_shape": {
          "items": {
            "type": "integer"
          },
          "title": "Minimum Shape",
          "type": "array"
        },
        "observed_shape": {
          "items": {
            "type": "integer"
          },
          "title": "Observed Shape",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "input_name",
        "observed_shape",
        "minimum_shape",
        "maximum_shape"
      ],
      "title": "ProfilePredicate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bounded reduction session input.",
  "properties": {
    "api_version": {
      "const": "upgradeguard.dev/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "confirmation_count": {
      "minimum": 2,
      "title": "Confirmation Count",
      "type": "integer"
    },
    "failure_code": {
      "$ref": "#/$defs/FailureCode"
    },
    "kind": {
      "const": "ReductionRequest",
      "title": "Kind",
      "type": "string"
    },
    "maximum_seconds": {
      "exclusiveMinimum": 0,
      "title": "Maximum Seconds",
      "type": "integer"
    },
    "maximum_trials": {
      "exclusiveMinimum": 0,
      "title": "Maximum Trials",
      "type": "integer"
    },
    "predicate": {
      "discriminator": {
        "mapping": {
          "numerical": "#/$defs/NumericalPredicate",
          "profile": "#/$defs/ProfilePredicate"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NumericalPredicate"
        },
        {
          "$ref": "#/$defs/ProfilePredicate"
        }
      ],
      "title": "Predicate"
    },
    "signature_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Signature Sha256",
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "kind",
    "failure_code",
    "signature_sha256",
    "confirmation_count",
    "maximum_trials",
    "maximum_seconds",
    "predicate"
  ],
  "title": "ReductionRequest",
  "type": "object"
}
