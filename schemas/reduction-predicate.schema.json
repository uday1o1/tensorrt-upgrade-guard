        "CORPUS_INVALID",
        "PLUGIN_COMPILE_FAILED",
        "ONNX_PARSE_FAILED",
        "ENGINE_BUILD_FAILED",
        "ENGINE_DESERIALIZE_FAILED",
        "PROFILE_REJECTED",
        "EXECUTION_FAILED",
        "OUTPUT_SCHEMA_CHANGED",
        "NONFINITE_OUTPUT",
        "NUMERICAL_REGRESSION",
        "NONDETERMINISM_REGRESSION",
        "PERFORMANCE_REGRESSION",
        "MEMORY_REGRESSION",
        "SANITIZER_FAILURE",
        "INFRASTRUCTURE_INVALID",
        "INCONCLUSIVE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "ReductionEnvironmentIdentity": {
