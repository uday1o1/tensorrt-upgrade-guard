      },
      "title": "Input Sha256",
      "type": "array"
    },
    "model_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "output_name": {
      "anyOf": [
        {
          "maxLength": 256,
