      "title": "Environments",
      "type": "array"
    },
    "executor_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor Sha256"
    },
    "failure_code": {
      "$ref": "#/$defs/FailureCode"
    },
    "infrastructure_satisfies_predicate": {
