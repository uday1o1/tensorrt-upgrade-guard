{
  "$comment": "Generated by scripts/generate_schemas.py. Do not edit manually.",
  "$defs": {
    "FailureCode": {
      "description": "Stable V1 qualification failure taxonomy.",
      "enum": [
        "PREFLIGHT_UNSUPPORTED",
        "CORPUS_INVALID",
        "PLUGIN_COMPILE_FAILED",
        "ONNX_PARSE_FAILED",
        "ENGINE_BUILD_FAILED",
        "ENGINE_DESERIALIZE_FAILED",
        "PROFILE_REJECTED",
        "EXECUTION_FAILED",
        "OUTPUT_SCHEMA_CHANGED",
        "NONFINITE_OUTPUT",
        "NUMERICAL_REGRESSION",
        "NONDETERMINISM_REGRESSION",
        "PERFORMANCE_REGRESSION",
        "MEMORY_REGRESSION",
        "SANITIZER_FAILURE",
        "INFRASTRUCTURE_INVALID",
        "INCONCLUSIVE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "PredicateOutcome": {
      "description": "Behavioral outcomes with infrastructure invalidity kept distinct.",
      "enum": [
        "reproduced",
        "not_reproduced",
        "infrastructure_invalid"
      ],
      "title": "PredicateOutcome",
      "type": "string"
    },
    "ReductionAttempt": {
      "additionalProperties": false,
      "description": "One hash-chained predicate attempt retained in execution order.",
      "properties": {
        "attempt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attempt Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "evidence_sha256": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Sha256",
          "type": "array"
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/PredicateOutcome"
        },
        "predicate_signature_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predicate Signature Sha256"
        },
        "previous_attempt_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Attempt Sha256"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "stage": {
          "$ref": "#/$defs/ReductionStage"
        }
      },
      "required": [
        "sequence",
        "stage",
        "candidate_sha256",
        "outcome",
        "failure_code",
        "predicate_signature_sha256",
        "evidence_sha256",
        "detail",
        "duration_seconds",
        "previous_attempt_sha256",
        "attempt_sha256"
      ],
      "title": "ReductionAttempt",
      "type": "object"
    },
    "ReductionEnvironmentIdentity": {
      "additionalProperties": false,
      "description": "One ordered locked worker identity used by the predicate.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "worker_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Worker Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "worker_manifest_sha256"
      ],
      "title": "ReductionEnvironmentIdentity",
      "type": "object"
    },
    "ReductionPredicateContract": {
      "additionalProperties": false,
      "description": "Complete original failure relation preserved by every reduction trial.",
      "properties": {
        "concrete_shapes": {
          "items": {
            "$ref": "#/$defs/ReductionShapeIdentity"
          },
          "title": "Concrete Shapes",
          "type": "array"
        },
        "confirmation_count": {
          "minimum": 2,
          "title": "Confirmation Count",
          "type": "integer"
        },
        "environments": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ReductionEnvironmentIdentity"
            },
            {
              "$ref": "#/$defs/ReductionEnvironmentIdentity"
            }
          ],
          "title": "Environments",
          "type": "array"
        },
        "executor_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executor Sha256"
        },
        "failure_code": {
          "$ref": "#/$defs/FailureCode"
        },
        "infrastructure_satisfies_predicate": {
          "const": false,
          "default": false,
          "title": "Infrastructure Satisfies Predicate",
          "type": "boolean"
        },
        "input_sha256": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Sha256",
          "type": "array"
        },
        "model_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Sha256",
          "type": "string"
        },
        "output_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Name"
        },
        "predicate_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Predicate Sha256",
          "type": "string"
        },
        "predicate_signature_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Predicate Signature Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "upgradeguard.dev/reduction-predicate/v1",
          "default": "upgradeguard.dev/reduction-predicate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "threshold_relationship": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Threshold Relationship",
          "type": "string"
        }
      },
      "required": [
        "failure_code",
        "predicate_signature_sha256",
        "environments",
        "model_sha256",
        "concrete_shapes",
        "input_sha256",
        "threshold_relationship",
        "confirmation_count",
        "predicate_sha256"
      ],
      "title": "ReductionPredicateContract",
      "type": "object"
    },
    "ReductionShapeIdentity": {
      "additionalProperties": false,
      "description": "One named concrete shape retained by the original predicate.",
      "properties": {
        "dimensions": {
          "items": {
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "input_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Input Name",
          "type": "string"
        }
      },
      "required": [
        "input_name",
        "dimensions"
      ],
      "title": "ReductionShapeIdentity",
      "type": "object"
    },
    "ReductionStage": {
      "description": "Required V1 reduction order plus confirmation and clean replay boundaries.",
      "enum": [
        "confirm_original",
        "outputs",
        "concrete_shape",
        "optimization_profile",
        "inputs",
        "builder_options",
        "freeze_dynamic_shape",
        "fold_shape_operations",
        "polygraphy_bisect",
        "polygraphy_linear",
        "environment_history",
        "final_empty_replay"
      ],
      "title": "ReductionStage",
      "type": "string"
    },
    "ReductionStatus": {
      "description": "Terminal bounded-session status.",
      "enum": [
        "completed",
        "budget_exhausted",
        "infrastructure_invalid"
      ],
      "title": "ReductionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Portable, bounded, hash-chained reduction execution evidence.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/ReductionAttempt"
      },
      "title": "Attempts",
      "type": "array"
    },
    "completed_stages": {
      "items": {
        "$ref": "#/$defs/ReductionStage"
      },
      "title": "Completed Stages",
      "type": "array"
    },
    "confirmation_count": {
      "minimum": 2,
      "title": "Confirmation Count",
      "type": "integer"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "expected_failure_code": {
      "$ref": "#/$defs/FailureCode"
    },
    "final_candidate_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Final Candidate Sha256",
      "type": "string"
    },
    "maximum_seconds": {
      "exclusiveMinimum": 0,
      "title": "Maximum Seconds",
      "type": "number"
    },
    "maximum_trials": {
      "exclusiveMinimum": 0,
      "title": "Maximum Trials",
      "type": "integer"
    },
    "original_candidate_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Original Candidate Sha256",
      "type": "string"
    },
    "predicate": {
      "$ref": "#/$defs/ReductionPredicateContract"
    },
    "predicate_signature_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Predicate Signature Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "upgradeguard.dev/reduction-session/v1",
      "default": "upgradeguard.dev/reduction-session/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Session Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReductionStatus"
    }
  },
  "required": [
    "predicate",
    "status",
    "expected_failure_code",
    "predicate_signature_sha256",
    "original_candidate_sha256",
    "final_candidate_sha256",
    "completed_stages",
    "attempts",
    "maximum_trials",
    "maximum_seconds",
    "confirmation_count",
    "elapsed_seconds",
    "session_sha256"
  ],
  "title": "ReductionSessionManifest",
  "type": "object"
}
