{
  "$comment": "Generated by scripts/generate_schemas.py. Do not edit manually.",
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "One relative artifact with verified content identity.",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "media_type"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CudaArchitectureBuild": {
      "additionalProperties": false,
      "description": "Original GPU architecture bound to replay-time CUDA compilation.",
      "properties": {
        "cmake_cuda_architecture": {
          "pattern": "^[1-9][0-9]+$",
          "title": "Cmake Cuda Architecture",
          "type": "string"
        },
        "original_compute_capability": {
          "maxLength": 8,
          "minLength": 3,
          "title": "Original Compute Capability",
          "type": "string"
        }
      },
      "required": [
        "original_compute_capability",
        "cmake_cuda_architecture"
      ],
      "title": "CudaArchitectureBuild",
      "type": "object"
    },
    "FailureCode": {
      "description": "Stable V1 qualification failure taxonomy.",
      "enum": [
        "PREFLIGHT_UNSUPPORTED",
        "CORPUS_INVALID",
        "PLUGIN_COMPILE_FAILED",
        "ONNX_PARSE_FAILED",
        "ENGINE_BUILD_FAILED",
        "ENGINE_DESERIALIZE_FAILED",
        "PROFILE_REJECTED",
        "EXECUTION_FAILED",
        "OUTPUT_SCHEMA_CHANGED",
        "NONFINITE_OUTPUT",
        "NUMERICAL_REGRESSION",
        "NONDETERMINISM_REGRESSION",
        "PERFORMANCE_REGRESSION",
        "MEMORY_REGRESSION",
        "SANITIZER_FAILURE",
        "INFRASTRUCTURE_INVALID",
        "INCONCLUSIVE"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "FailureRecord": {
      "additionalProperties": false,
      "description": "Complete stable failure predicate and evidence.",
      "properties": {
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "environment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Environment Id"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "input_fixture_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Fixture Id"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Id"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "output_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Name"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "precision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "shape_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shape Id"
        },
        "signature_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Signature Sha256",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "code",
        "phase",
        "environment_id",
        "model_id",
        "precision",
        "shape_id",
        "input_fixture_id",
        "output_name",
        "gate",
        "observed",
        "threshold",
        "evidence",
        "signature_sha256"
      ],
      "title": "FailureRecord",
      "type": "object"
    },
    "LocalWorkerBuild": {
      "additionalProperties": false,
      "description": "Hash-bound recipe for rebuilding the worker without a published worker image.",
      "properties": {
        "base_image": {
          "maxLength": 512,
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "title": "Base Image",
          "type": "string"
        },
        "base_image_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Image Manifest Digest",
          "type": "string"
        },
        "build_arguments": {
          "items": {
            "$ref": "#/$defs/WorkerBuildArgument"
          },
          "title": "Build Arguments",
          "type": "array"
        },
        "cuda_architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/CudaArchitectureBuild"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dockerfile": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "worker_lock": {
          "$ref": "#/$defs/ArtifactReference"
        }
      },
      "required": [
        "base_image",
        "base_image_manifest_digest",
        "dockerfile",
        "worker_lock",
        "build_arguments"
      ],
      "title": "LocalWorkerBuild",
      "type": "object"
    },
    "Phase": {
      "description": "Stable qualification phases.",
      "enum": [
        "preflight",
        "materialize",
        "build",
        "reference",
        "correctness",
        "determinism",
        "performance",
        "memory",
        "reduction",
        "sanitizer",
        "profiling",
        "reproduction",
        "report"
      ],
      "title": "Phase",
      "type": "string"
    },
    "PrecisionMode": {
      "description": "Frozen precision artifact identities.",
      "enum": [
        "fp32",
        "explicit_fp16",
        "qdq"
      ],
      "title": "PrecisionMode",
      "type": "string"
    },
    "ReplayRequirements": {
      "additionalProperties": false,
      "description": "Portable target requirements independent of the original GPU identity.",
      "properties": {
        "minimum_compute_capability": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Minimum Compute Capability",
          "type": "string"
        },
        "minimum_driver": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Minimum Driver",
          "type": "string"
        },
        "minimum_vram_mib": {
          "exclusiveMinimum": 0,
          "title": "Minimum Vram Mib",
          "type": "integer"
        },
        "platform": {
          "const": "linux/amd64",
          "default": "linux/amd64",
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "minimum_compute_capability",
        "minimum_driver",
        "minimum_vram_mib"
      ],
      "title": "ReplayRequirements",
      "type": "object"
    },
    "SourceBuildRequest": {
      "additionalProperties": false,
      "description": "Source code that requires explicit operator trust before compilation.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "cuda_architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/CudaArchitectureBuild"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "local_worker_build": {
          "$ref": "#/$defs/LocalWorkerBuild"
        },
        "original_gpu_uuid": {
          "pattern": "^GPU-[A-Fa-f0-9-]+$",
          "title": "Original Gpu Uuid",
          "type": "string"
        },
        "original_worker_image_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Worker Image Manifest Digest",
          "type": "string"
        },
        "replay_requirements": {
          "$ref": "#/$defs/ReplayRequirements"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "sources",
        "original_worker_image_manifest_digest",
        "original_gpu_uuid",
        "replay_requirements",
        "local_worker_build",
        "command"
      ],
      "title": "SourceBuildRequest",
      "type": "object"
    },
    "WorkerBuildArgument": {
      "additionalProperties": false,
      "description": "One reviewed Docker build argument without shell interpretation.",
      "properties": {
        "name": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "WorkerBuildArgument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Typed reproduction contents, limits, and expected predicate.",
  "properties": {
    "api_version": {
      "const": "upgradeguard.dev/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "baseline_environment": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "candidate_environment": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expanded_size_limit_bytes": {
      "default": 2147483648,
      "maximum": 68719476736,
      "minimum": 1,
      "title": "Expanded Size Limit Bytes",
      "type": "integer"
    },
    "expected_failure": {
      "$ref": "#/$defs/FailureRecord"
    },
    "file_count_limit": {
      "default": 512,
      "maximum": 4096,
      "minimum": 1,
      "title": "File Count Limit",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Files",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "included_engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Inputs",
      "type": "array"
    },
    "kind": {
      "const": "ReproductionBundle",
      "title": "Kind",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "qualification": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "source_build": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceBuildRequest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "api_version",
    "kind",
    "id",
    "created_at",
    "files",
    "baseline_environment",
    "candidate_environment",
    "qualification",
    "expected_failure",
    "model",
    "inputs",
    "source_build",
    "included_engine",
    "manifest_sha256"
  ],
  "title": "BundleManifest",
  "type": "object"
}
