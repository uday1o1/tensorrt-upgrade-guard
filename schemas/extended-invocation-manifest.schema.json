      "title": "Suite",
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "kind",
    "suite",
    "source_git_commit",
    "matrix_lock_sha256",
    "specification_sha256",
    "corpus_lock_sha256",
    "corpus_manifest_sha256",
    "environment_ids",
    "manifest_sha256"
