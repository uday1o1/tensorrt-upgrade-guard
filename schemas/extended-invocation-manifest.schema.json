{
  "$comment": "Generated by scripts/generate_schemas.py. Do not edit manually.",
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "One relative artifact with verified content identity.",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "media_type"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "PluginBuildProvenance": {
      "additionalProperties": false,
      "description": "Exact source, binary, commands, and build log for one plugin environment.",
      "properties": {
        "binary": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "build_command": {
          "items": {
            "type": "string"
          },
          "title": "Build Command",
          "type": "array"
        },
        "build_log": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "compile_commands": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "configure_command": {
          "items": {
            "type": "string"
          },
          "title": "Configure Command",
          "type": "array"
        },
        "environment_id": {
          "title": "Environment Id",
          "type": "string"
        },
        "source_inventory": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Source Inventory",
          "type": "array"
        },
        "source_inventory_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Inventory Sha256",
          "type": "string"
        },
        "test_command": {
          "items": {
            "type": "string"
          },
          "title": "Test Command",
          "type": "array"
        }
      },
      "required": [
        "environment_id",
        "source_inventory",
        "source_inventory_sha256",
        "binary",
        "compile_commands",
        "build_log",
        "configure_command",
        "build_command",
        "test_command"
      ],
      "title": "PluginBuildProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Self-hashed host invocation identity for stable extended artifacts.",
  "properties": {
    "api_version": {
      "const": "upgradeguard.dev/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "corpus_lock_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Corpus Lock Sha256",
      "type": "string"
    },
    "corpus_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Corpus Manifest Sha256",
      "type": "string"
    },
    "environment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Environment Ids",
      "type": "array"
    },
    "kind": {
      "const": "ExtendedInvocationManifest",
      "title": "Kind",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "matrix_lock_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Matrix Lock Sha256",
      "type": "string"
    },
    "plugin_builds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PluginBuildProvenance"
      },
      "title": "Plugin Builds",
      "type": "array"
    },
    "source_git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Git Commit",
      "type": "string"
    },
    "specification_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Specification Sha256",
      "type": "string"
    },
    "suite": {
      "enum": [
        "plugin",
        "mobilenet"
