# syntax=docker/dockerfile:1

ARG BASE_IMAGE=nvcr.io/nvidia/tensorrt:26.06-py3@sha256:2a5a0a9a32ec5ddc1c384c15ddcf3b89ddc4f8647e7ee7ae708d844210183a1e
FROM ${BASE_IMAGE}

ARG BASE_MANIFEST_DIGEST
LABEL com.udayarora.upgradeguard.base.manifest.digest="${BASE_MANIFEST_DIGEST}"

COPY containers/requirements-worker.txt /tmp/requirements-worker.txt

RUN python3 -m pip install --no-cache-dir --require-hashes \
      --requirement /tmp/requirements-worker.txt \
    && python3 -m pip check

# UpgradeGuard source is mounted read-only and hashed for each run.
# The worker image freezes NVIDIA and CPU reference dependencies without embedding mutable project code.
